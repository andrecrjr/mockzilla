FROM oven/bun:1-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# Build stage: install dependencies and export the landing page
FROM base AS builder
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile
COPY . .
# The static site exposes only the landing page and documentation. Removing the
# dashboard and API trees before Next collects page data keeps database-backed
# modules out of the export.
RUN rm -rf app/api app/app app/llms-full.txt app/llms.txt proxy.ts && rm -f app/robots.ts app/sitemap.ts
ENV NEXT_DISABLE_ESLINT=true
ENV DEPLOY_MODE=landing
RUN bun run build

# Keep only the exported landing/docs pages and browser assets. This deliberately
# excludes dashboard, API, and database server code.
FROM alpine:3.22 AS landing-assets
WORKDIR /landing
COPY --from=builder /app/out ./
COPY --from=builder /app/public ./

# Static file server: no Node, Bun, migrations, or database dependencies.
FROM nginx:1.29-alpine AS runner
WORKDIR /app

COPY --from=landing-assets /landing /usr/share/nginx/html
COPY nginx.landing.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
